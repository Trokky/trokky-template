{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trokky-template",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Trokky's core imports crypto, events and module directly.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Every request goes through the Worker: /studio needs its config injected, and /api
    // is not a file. Static files are fetched through the binding by the handlers.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "trokky-template", "database_id": "" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "trokky-template-media" }
  ],
  // Thumbnails are made through the Images binding at upload time.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
